<Window x:Class="week06.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:week06"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="WPF小畫家" Height="450" Width="800">
    <DockPanel>

        <Menu Height="30"  DockPanel.Dock="Top">
            <MenuItem Header="檔案" Height="30" VerticalContentAlignment="Center" FontSize="16">
                <MenuItem Header="開啟新畫布" VerticalContentAlignment="Center" FontSize="16"/>
                <MenuItem Header="儲存畫布" VerticalContentAlignment="Center" FontSize="16"/>
            </MenuItem>
        </Menu>
        <ToolBarTray Height="40" Background="LightCyan" DockPanel.Dock="Top">
            <ToolBar Height="38" Width="600" Background="#FF96F3F3">
                <Label Content="筆刷色彩" FontSize="16" VerticalContentAlignment="Center" FontWeight="Bold" Margin="10,0,0,0"/>
                <xctk:ColorPicker x:Name="StrokeColorPicker" Width="100" Height="30" DisplayColorAndName="True" SelectedColorChanged="StrokeColorPicker_SelectedColorChanged"/>
                <Label Content="填滿色彩" FontSize="16" VerticalContentAlignment="Center" FontWeight="Bold" Margin="10,0,0,0"/>
                <xctk:ColorPicker x:Name="FillColorPicker" Width="100" Height="30" DisplayColorAndName="True" SelectedColorChanged="FillColorPicker_SelectedColorChanged"/>
                <Slider x:Name="ThicknessSlider" Width="120" Minimum="1" Maximum="10" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="31,0,0,0" ValueChanged="ThicknessSlider_ValueChanged"/>
                <Label FontSize="14" FontWeight="Bold" Margin="10,0,0,0" Content="{Binding Value, ElementName=ThicknessSlider}" VerticalAlignment="Center" Foreground="Red"/>
            </ToolBar>
            <ToolBar Height="38" Width="600" Background="#FFA8D684">
                <RadioButton Height="35" Width="35" FontSize="14" Checked="ShapeBotton_checked" Tag="Line">
                    <Image Source="/line.png" />
                </RadioButton>
                <RadioButton Height="35" Width="35" FontSize="14" Checked="ShapeBotton_checked" Tag="Rectangle">
                    <Image Source="/Rectangle.png" />
                </RadioButton>
                <RadioButton Height="35" Width="35" FontSize="14" Checked="ShapeBotton_checked" Tag="Ellipse">
                    <Image Source="/Ellipse.png" />
                </RadioButton>
                <RadioButton Height="35" Width="35" FontSize="14" Checked="ShapeBotton_checked" Tag="polyline">
                    <Image Source="/polyline.png" />
                </RadioButton>
                
            </ToolBar>
        </ToolBarTray>
        <StatusBar Height="35" Background="LightGray" DockPanel.Dock="Bottom">
            <StatusBarItem Width="400">
                <Label x:Name="StatusLabel" Content="Ready" VerticalAlignment="Center" FontSize="14" Width="360" Margin="10,0,0,0"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem Width="200">
                <Label x:Name="ShapeLabel" Content="形狀" VerticalAlignment="Center" FontSize="14" Width="1500" Margin="10,0,0,0"></Label>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <Label x:Name="ColorLabel" Content="色彩" VerticalAlignment="Center" FontSize="14" Margin="10,0,0,0"></Label>
            </StatusBarItem>
        </StatusBar>
        <Canvas x:Name="MyCanvas" Background="#FFF5F5E7" MouseEnter="MtCanvas_MouseEnter" MouseLeftButtonDown="MtCanvas_MouseLeftButtonDown" MouseMove="MyCanvas_MouseMove" MouseRightButtonUp="MyCanvas_MouseRightButtonUp" />


    </DockPanel>
</Window>
